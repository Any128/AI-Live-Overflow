<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  html, body { margin:0; padding:0; background:transparent; }
  #pet { width:100vw; height:100vh; display:block; }
  .face { transition: transform 0.15s ease; transform-origin: center; }
</style>
</head>
<body>
<svg id="pet" viewBox="0 0 180 240" xmlns="http://www.w3.org/2000/svg">
  <!-- 占位小生物：圆头 + 眼睛 + 嘴，替换成你自己的 SVG 素材 -->
  <g class="face">
    <circle cx="90" cy="120" r="70" fill="#ffe0b2" stroke="#d7a86e" stroke-width="4"/>
    <circle cx="60" cy="110" r="9" fill="#333"/>
    <circle cx="120" cy="110" r="9" fill="#333"/>
    <circle cx="60" cy="110" r="3" fill="#fff"/>
    <circle cx="120" cy="110" r="3" fill="#fff"/>
    <path id="mouth" d="M 75 145 Q 90 158 105 145" stroke="#333" stroke-width="4"
          fill="none" stroke-linecap="round"/>
  </g>
</svg>

<script>
  // 原生层通过 evaluateJavascript 调用这里的 petEngine
  var petEngine = {
    onTap: function() { react('tap'); },
    onDoubleTap: function() { react('doubletap'); },
    onLongPress: function() { react('longpress'); }
  };

  function react(type) {
    var mouth = document.getElementById('mouth');
    var face = document.querySelector('.face');

    if (type === 'tap') {
      mouth.setAttribute('d', 'M 70 145 Q 90 165 110 145');
      showBubble('嘻嘻');
    } else if (type === 'doubletap') {
      face.style.transform = 'scale(1.15)';
      setTimeout(function(){ face.style.transform = 'scale(1)'; }, 150);
      showBubble('别戳啦！');
    } else if (type === 'longpress') {
      face.style.transform = 'rotate(15deg)';
      setTimeout(function(){ face.style.transform = 'rotate(0)'; }, 300);
      showBubble('？');
    }
  }

  function showBubble(text) {
    var old = document.getElementById('bubble');
    if (old) old.remove();
    var b = document.createElement('div');
    b.id = 'bubble';
    b.textContent = text;
    b.style.cssText = 'position:absolute;top:20px;left:50%;transform:translateX(-50%);' +
      'background:#fff;color:#333;padding:6px 12px;border-radius:14px;font-size:14px;' +
      'box-shadow:0 2px 8px rgba(0,0,0,0.25);white-space:nowrap;';
    document.body.appendChild(b);
    setTimeout(function(){ if (b.parentNode) b.remove(); }, 1500);
  }
</script>
</body>
</html>
