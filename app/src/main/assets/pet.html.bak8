<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  html, body { margin:0; padding:0; background:transparent; }
  #pet { width:100vw; height:100vh; display:block; image-rendering: pixelated; }
  /* 只有 .face 会跟着动，影子留在外面不动 */
  .face { transition: transform 0.15s ease; transform-origin: center; }
</style>
</head>
<body>
<svg id="pet" viewBox="0 0 180 240" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
  <!-- 影子：细长半透明灰色长方形，放在 g 外面，不会跟着缩放/旋转 -->
  <rect x="45" y="170" width="90" height="4" fill="#000000" opacity="0.25"/>

  <g class="face">
    <!-- 螃蟹身体（正长方形，没有头顶的空缺） -->
    <rect x="60" y="115" width="60" height="45" fill="#e8735a"/>
    
    <!-- 左钳子（简单的方块） -->
    <rect x="35" y="130" width="20" height="15" fill="#e8735a"/>
    <!-- 右钳子（简单的方块） -->
    <rect x="125" y="130" width="20" height="15" fill="#e8735a"/>

    <!-- 螃蟹眼睛（黑色方块，贴在身体内部靠上的位置） -->
    <rect x="75" y="125" width="8" height="12" fill="#1a1a1a"/>
    <rect x="97" y="125" width="8" height="12" fill="#1a1a1a"/>
    
    <!-- 螃蟹腿：左右各两条，细一点，中间留空 -->
    <rect x="68" y="160" width="6" height="12" fill="#e8735a"/>
    <rect x="80" y="160" width="6" height="12" fill="#e8735a"/>
    <rect x="94" y="160" width="6" height="12" fill="#e8735a"/>
    <rect x="106" y="160" width="6" height="12" fill="#e8735a"/>
    
    <!-- 嘴巴（方块） -->
    <rect id="mouth" x="85" y="145" width="10" height="4" fill="#1a1a1a"/>
  </g>
</svg>

<script>
  // 原生层通过 evaluateJavascript 调用这里的 petEngine
  var petEngine = {
    onTap: function() { react('tap'); },
    onDoubleTap: function() { react('doubletap'); },
    onLongPress: function() { react('longpress'); }
  };

  function react(type) {
    var mouth = document.getElementById('mouth');
    var face = document.querySelector('.face');

    if (type === 'tap') {
      mouth.setAttribute('width', '14');
      mouth.setAttribute('x', '83');
      showBubble('嘎嘎！');
    } else if (type === 'doubletap') {
      face.style.transform = 'scale(1.15)';
      setTimeout(function(){ face.style.transform = 'scale(1)'; }, 150);
      showBubble('别戳啦！');
    } else if (type === 'longpress') {
      face.style.transform = 'rotate(15deg)';
      setTimeout(function(){ face.style.transform = 'rotate(0)'; }, 300);
      showBubble('？');
    }
  }

  function showBubble(text) {
    var old = document.getElementById('bubble');
    if (old) old.remove();
    var b = document.createElement('div');
    b.id = 'bubble';
    b.textContent = text;
    b.style.cssText = 'position:absolute;top:20px;left:50%;transform:translateX(-50%);' +
      'background:#fff;color:#333;padding:6px 12px;border-radius:12px;font-size:16px;' +
      'box-shadow:0 2px 8px rgba(0,0,0,0.2);white-space:nowrap;';
    document.body.appendChild(b);
    setTimeout(function(){ b.remove(); }, 2000);
  }
</script>
</body>
</html>
